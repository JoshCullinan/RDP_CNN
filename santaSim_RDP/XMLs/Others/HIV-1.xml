<santa xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="santa.xsd">
	<replicates>1</replicates>
	<simulation>
		<genome>
			<!-- http://www.ncbi.nlm.nih.gov/nuccore/K03455.1 -->
			<length>9719</length>

			<sequences>
				
			</sequences>

			<feature>
				<name>gag</name>
				<type>nucleotide</type>
				<coordinates>790-2292</coordinates>
			</feature>

			<feature>
				<name>pol</name>
				<type>nucleotide</type>
				<coordinates>2358-5096</coordinates>
			</feature>

			<feature>
				<name>env</name>
				<type>nucleotide</type>
				<coordinates>6225-8795</coordinates>
			</feature>

		</genome>

		<population>
			<populationSize>250</populationSize>
			<inoculum>all</inoculum>
		</population>

		<fitnessFunction>

			<exposureDependentFitness>
				<feature>gag</feature>
				<penalty>0.01</penalty>
			</exposureDependentFitness>

			<exposureDependentFitness>
				<feature>pol</feature>
				<penalty>0.01</penalty>
			</exposureDependentFitness>
			
			<exposureDependentFitness>
				<feature>env</feature>
				<penalty>0.05</penalty>
			</exposureDependentFitness>

		</fitnessFunction>

		<mutator>
			<nucleotideMutator>
			    <indelmodel model="NB">0.3 3</indelmodel>
                <insertprob>2E-1</insertprob>
                <deleteprob>2.5E-1</deleteprob>  
				<mutationRate>1.16E-4</mutationRate>
				<rateBias>
	                    0.42 2.49 0.29
	                    1.73 0.23 4.73
	                    6.99 0.20 0.60
	                    1.02 2.56 0.88
	                </rateBias>
			</nucleotideMutator>
		</mutator>

		<replicator>
			<recombinantReplicator>
				<dualInfectionProbability>0.1</dualInfectionProbability>
				<recombinationProbability>0.075</recombinationProbability>
			</recombinantReplicator>
		</replicator>

		<epoch>
			<name>initial</name>
			<generationCount>3000</generationCount>			
		</epoch>
		
		<samplingSchedule>      
                
                <!-- Sample genotypes at certain times in FASTA Format -->
                <sampler>
                    <atGeneration>3000</atGeneration>
                    <fileName>alignment_0.fa</fileName>
                    <alignment>
                        <sampleSize>150</sampleSize>
                        <format>FASTA</format>
                        <label>seq_%g_%s</label>
                    </alignment>
                </sampler>   

            </samplingSchedule>
	</simulation>
</santa>
