<!--generationCount = [1500, 2000, 2500, 3000, 3500]-->
<!-- recombinationProbability = [0.07, 0.075]  -->
<!-- mutationRate = [1.14E-5, 1.18E-5, 1.1E-5] -->
<!-- sampleSize = [150] -->
<!--  populationSize = [2500]-->
<santa xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="santa.xsd">
	<!-- NOTE__DO NOT COMMENT ABOVE THE <santa> line!  -->
	<replicates>1</replicates>
	<simulation>
		<genome>
			<!-- http://www.ncbi.nlm.nih.gov/nuccore/K03455.1 -->
			<length>9719</length>
			<sequences>
				
			</sequences>
			<feature>
				<name>PR</name>
				<type>aminoAcid</type>
				<!-- Ensure feature is exactly 99 codons long -->
				<coordinates>2253-2549</coordinates>
			</feature>
			<feature>
				<name>RT</name>
				<type>aminoAcid</type>
				<coordinates>2550-4229</coordinates>
			</feature>
			<feature>
				<name>IN</name>
				<type>aminoAcid</type>
				<coordinates>4230-5096</coordinates>
			</feature>
		</genome>

		<population>
			<populationSize>$populationSize</populationSize>
			<inoculum>all</inoculum>
		</population>

		<fitnessFunction>
			<populationSizeDependentFitness>
				<feature>PR</feature>
				<sites>1-99</sites>
				<declineRate>0.05</declineRate>
				<maxPopulationSize>1000</maxPopulationSize>
			</populationSizeDependentFitness>
			<empiricalFitness id="RT1">
	                <feature>RT</feature>
	                <sites>1</sites>
                    <values>
                        0.01 <!-- A -->
                        0.01 <!-- C -->
                        0.3 <!-- D -->
                        0.01 <!-- E -->
                        0.01 <!-- F-->
                        0.71 <!-- G -->
                        0.01 <!-- H -->
                        0.01 <!-- I -->
                        0.01 <!-- K -->
                        0.21 <!-- L -->
                        0.01 <!-- M -->
                        0.41 <!-- N -->
                        1.20 <!-- P -->
                        0.01 <!-- Q -->
                        0.11 <!-- R -->
                        0.80 <!-- S -->
                        0.11 <!-- T -->
                        0.01 <!-- V -->
                        0.01 <!-- W -->
                        0.31 <!-- Y -->
                    </values>
                </empiricalFitness>
		</fitnessFunction>

		<mutator>
			<nucleotideMutator>
			    <indelmodel model="NB">0.3 2</indelmodel>
                <insertprob>2E-2</insertprob>
                <deleteprob>2.5E-2</deleteprob>  
				<mutationRate>$mutationRate</mutationRate>
				<rateBias>
	                    0.42 2.49 0.29
	                    1.73 0.23 4.73
	                    6.99 0.20 0.60
	                    1.02 2.56 0.88
	                </rateBias>
			</nucleotideMutator>
		</mutator>

		<replicator>
			<recombinantReplicator>
				<dualInfectionProbability>0.1</dualInfectionProbability>
				<recombinationProbability>$recombinationProbability</recombinationProbability>
			</recombinantReplicator>
		</replicator>

		<epoch>
			<generationCount>$generationCount</generationCount>			
		</epoch>
		
		<samplingSchedule>
            <sampler>
                <atGeneration>$generationCount</atGeneration>
				<!-- Keep this variable as alignmentName -->
                <fileName>$alignmentName</fileName>
                <alignment>
                    <sampleSize>$sampleSize</sampleSize>
                    <format>FASTA</format>
                    <label>seq_%g_%s</label>
                </alignment>
            </sampler> 
		</samplingSchedule>
	</simulation>
</santa>