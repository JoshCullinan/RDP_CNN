<santa xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="santa.xsd">

        <replicates>1</replicates>

        <simulation>

            <genome>
                <length>3822</length>
	            <sequences>
                
                </sequences>   
           </genome>


            <population>
                <populationSize>1000</populationSize>
                <inoculum>all</inoculum>
            </population>

            <populationType>staticPopulation</populationType>           

            <fitnessFunction> 
                <neutralFitness>
                    <sites>1-3822</sites>
                </neutralFitness>                             
            </fitnessFunction>

	        <mutator>
	            <nucleotideMutator>
	                <mutationRate>2.5E-6</mutationRate>
                    <indelmodel model="NB">0.4 1</indelmodel>
                    <insertprob>16E-2</insertprob>
                    <deleteprob>12E-2</deleteprob>
                    <!-- 1.0E-4 3E-2 2E-2 -->
	                <rateBias>
	                    0.42 2.49 0.29
	                    1.73 0.23 4.73
	                    6.99 0.20 0.60
	                    1.02 2.56 0.88
	                </rateBias>
	            </nucleotideMutator>
	        </mutator>

	        <replicator>
	            <recombinantReplicator>
			         <dualInfectionProbability>0.1</dualInfectionProbability>
			         <recombinationProbability>0.08</recombinationProbability>
		      </recombinantReplicator>
	        </replicator>

            <epoch>
                <name>epoch1</name>
                <generationCount>2500</generationCount>
            </epoch>

           
            <samplingSchedule>      
                
                <!-- Sample genotypes at certain times in FASTA Format -->
                <sampler>
                    <atFrequency>2500</atFrequency>
                    <fileName>alignment_0.fa</fileName>
                    <alignment>
                        <sampleSize>50</sampleSize>
                        <format>FASTA</format>
                        <label>seq_%g_%s</label>
                    </alignment>
                </sampler>   

            </samplingSchedule>

        </simulation>
</santa>
